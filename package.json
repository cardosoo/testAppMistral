{
  "name": "mistral-chat-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "App web minimale : chat avec l'API Mistral (SDK TypeScript officiel)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "start": "tsx --env-file-if-exists=.env server.ts",
    "typecheck": "tsc --noEmit",
    "demo:db": "tsx --env-file-if-exists=.env scripts/demo-db.ts",
    "selftest": "tsx --env-file-if-exists=.env scripts/selftest.ts"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0",
    "express": "^5.3.0",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
