# Clé API Mistral, à récupérer sur https://console.mistral.ai
# Ne jamais commiter le fichier .env contenant la vraie clé.
MISTRAL_API_KEY=

# --- NL2SQL (optionnel) ---
# Connexion PostgreSQL avec un rôle STRICTEMENT read-only (voir db/ et README).
# Base de démo embarquée : npm run demo:db  (puis copiez l'URL affichée ici)
DATABASE_URL=postgres://chatbot_read:chatbot_read_demo@localhost:5433/chatbot_demo
# NL2SQL_SCHEMA=public
# NL2SQL_MAX_ROWS=200
# NL2SQL_TIMEOUT_MS=5000
# NL2SQL_MODEL=mistral-small-latest
# NL2SQL_ALLOWED_TABLES=enseignant,ue,affectation   # liste blanche (sinon: toutes les tables du schéma)
